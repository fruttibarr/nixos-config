{ config, pkgs, lib, quickshell, ... }:
let
  # Default keybinds, shared with Settings › Keybinds in the Quickshell panel
  # (which rebinds them live and persists changes to settings.lua).
  keybinds = builtins.fromJSON (builtins.readFile ./quickshell/keybinds.json);
  # A JSON string literal is also a valid Lua string literal (ASCII only).
  luaStr = builtins.toJSON;
  bindDsp = b: if b ? exec then "hl.dsp.exec_cmd(${luaStr b.exec})" else b.dsp;
  bindLine = b:
    "hl.bind(${luaStr b.keys}, ${bindDsp b}${lib.optionalString (b ? opts) ", ${b.opts}"})";
in
{
  home.packages = with pkgs; [
    polkit_gnome
  ];

  # Hyprland 0.55 deprecated the hyprlang (.conf) format in favour of Lua, and
  # 0.57 removes it entirely — so this config is written against the Lua API
  # (see $out/share/hypr/stubs/hl.meta.lua in the hyprland package for types).
  xdg.configFile."hypr/hyprland.lua".text = ''
    -- Managed by home-manager — see /etc/nixos/home/hyprland.nix

    -- colors.lua is regenerated by matugen on every wallpaper change and is
    -- NOT managed by home-manager. pcall keeps the compositor bootable if the
    -- file is missing or mid-write.
    local colorsPath = os.getenv("HOME") .. "/.config/hypr/colors.lua"
    local ok, colors = pcall(dofile, colorsPath)
    if not ok or type(colors) ~= "table" then
        colors = {
            primary = "rgb(c7bfff)",
            surface = "rgb(1f1e26)",
            text    = "rgb(e5e1e9)",
            outline = "rgb(484553)",
        }
    end

    hl.config({ autogenerated = false })

    ------------------
    ---- MONITORS ----
    ------------------

    hl.monitor({
        output   = "",
        mode     = "1920x1080@60",
        position = "auto",
        scale    = 1,
    })

    -------------------------------
    ---- ENVIRONMENT VARIABLES ----
    -------------------------------

    hl.env("NIXOS_OZONE_WL", "1")
    hl.env("QT_QPA_PLATFORM", "wayland")
    hl.env("GDK_BACKEND", "wayland,x11")
    hl.env("XDG_CURRENT_DESKTOP", "Hyprland")
    hl.env("XDG_SESSION_TYPE", "wayland")
    -- Default cursor (matches home.pointerCursor in chasec.nix). Set here too
    -- because Hyprland reads these at startup, before any shell profile runs.
    -- The settings panel overrides them from settings.lua, loaded last.
    hl.env("XCURSOR_THEME", "Bibata-Modern-Classic")
    hl.env("HYPRCURSOR_THEME", "Bibata-Modern-Classic")
    hl.env("XCURSOR_SIZE", "24")
    hl.env("HYPRCURSOR_SIZE", "24")

    -------------------
    ---- AUTOSTART ----
    -------------------

    hl.on("hyprland.start", function()
        hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
        hl.exec_cmd("${pkgs.polkit_gnome}/libexec/polkit-gnome-authentication-agent-1")
        -- Runs hyprpaper, restores the last wallpaper, restarts it on crash.
        hl.exec_cmd("wallpaper-daemon")
        hl.exec_cmd("hypridle")
        hl.exec_cmd("qs")
        -- NOTE: no always-on hidden kitty (`kitty -1 --start-as=hidden`)
        -- any more. After ~40 min one rendered all text as solid blocks
        -- (cause not reproducible; its stderr was discarded). Without it the
        -- shared instance exits with the last terminal, so closing all
        -- terminals always clears a bad state.
    end)

    -----------------------
    ---- LOOK AND FEEL ----
    -----------------------

    hl.config({
        general = {
            gaps_in  = 4,
            gaps_out = 10,

            border_size = 2,

            col = {
                active_border   = colors.primary,
                inactive_border = colors.surface,
            },

            resize_on_border = true,
            allow_tearing    = false,
            layout           = "dwindle",
        },

        decoration = {
            rounding       = 10,
            rounding_power = 2,

            active_opacity   = 1.0,
            inactive_opacity = 1.0,

            shadow = {
                enabled      = true,
                range        = 20,
                render_power = 3,
                color        = 0x55000000,
            },

            blur = {
                enabled  = true,
                size     = 6,
                passes   = 3,
                vibrancy = 0.1696,
            },
        },

        animations = {
            enabled = true,
        },

        dwindle = {
            -- NOTE: `pseudotile` is not a dwindle config key in 0.55 — it is
            -- only a dispatcher (bound to SUPER+P below).
            preserve_split = true,
        },

        input = {
            kb_layout    = "us",
            follow_mouse = 1,
            sensitivity  = 0,

            touchpad = {
                natural_scroll = true,
            },
        },

        misc = {
            disable_hyprland_logo     = true,
            disable_splash_rendering  = true,
            force_default_wallpaper   = 0,
        },
    })

    ----------------------
    ---- ANIMATIONS   ----
    ----------------------

    hl.curve("easeOutQuint",   { type = "bezier", points = { {0.23, 1},    {0.32, 1} } })
    hl.curve("easeInOutCubic", { type = "bezier", points = { {0.65, 0.05}, {0.36, 1} } })
    hl.curve("linear",         { type = "bezier", points = { {0, 0},       {1, 1}    } })
    hl.curve("easy",           { type = "spring", mass = 1, stiffness = 71.2633, dampening = 15.8273644 })
    -- Holds near 0 for the first half, then rises: the window stays hidden
    -- while the island's launch shape flies over it, and fades in as it lands.
    hl.curve("islandReveal",   { type = "bezier", points = { {0.6, 0},     {0.8, 1}  } })

    -- Defaults assume Settings › Animations › "Open windows out of the island"
    -- is on (Quickshell's WindowLaunch.qml animates the opening instead of
    -- Hyprland). Turning it off makes settings.lua restore the popin variant;
    -- keep this in sync with animationLua() in quickshell/services/HyprSettings.qml.
    hl.animation({ leaf = "global",     enabled = true, speed = 10,   bezier = "default" })
    hl.animation({ leaf = "border",     enabled = true, speed = 5.39, bezier = "easeOutQuint" })
    hl.animation({ leaf = "windows",    enabled = true, speed = 4.79, spring = "easy" })
    hl.animation({ leaf = "windowsIn",  enabled = false, speed = 4.1, spring = "easy",         style = "popin 85%" })
    hl.animation({ leaf = "windowsOut", enabled = true, speed = 1.49, bezier = "linear",       style = "popin 85%" })
    hl.animation({ leaf = "fade",       enabled = true, speed = 3.03, bezier = "easeOutQuint" })
    hl.animation({ leaf = "fadeIn",     enabled = true, speed = 5,    bezier = "islandReveal" })
    hl.animation({ leaf = "layers",     enabled = true, speed = 3.81, bezier = "easeOutQuint" })
    hl.animation({ leaf = "layersIn",   enabled = true, speed = 4,    bezier = "easeOutQuint", style = "fade" })
    hl.animation({ leaf = "layersOut",  enabled = true, speed = 1.5,  bezier = "linear",       style = "fade" })
    hl.animation({ leaf = "workspaces", enabled = true, speed = 1.94, bezier = "easeInOutCubic", style = "slide" })

    ---------------------
    ---- KEYBINDINGS ----
    ---------------------

    local mainMod = "SUPER"

    -- Rebindable binds come from quickshell/keybinds.json, which
    -- Settings › Keybinds also reads; user changes are applied on top by
    -- settings.lua (loaded last). Notes on the defaults:
    --  - `kitty -1` reuses the running kitty while any terminal is open, so
    --    a new terminal is a new window in an existing process (~30 ms
    --    instead of ~250). Its stderr goes to ~/.cache/kitty.log so a
    --    rendering failure leaves evidence. SUPER+SHIFT+T is a fully
    --    separate kitty, as an escape hatch if the shared one misbehaves.
    --  - Launcher + control center grow out of the Quickshell island;
    --    fuzzel stays installed as a fallback (SUPER+SHIFT+D).
    ${lib.concatMapStringsSep "\n" bindLine keybinds.binds}

    -- Workspaces: <focus mod>+N to focus, <move mod>+N to move the window.
    -- The key strings must stay "<mod> + <digit>": settings.lua unbinds
    -- them by that exact string when the modifiers are changed.
    for i = 1, 10 do
        local key = i % 10 -- workspace 10 lives on the 0 key
        hl.bind(${luaStr keybinds.workspaces.focus} .. " + " .. key, hl.dsp.focus({ workspace = i }))
        hl.bind(${luaStr keybinds.workspaces.move} .. " + " .. key,  hl.dsp.window.move({ workspace = i }))
    end

    hl.bind(mainMod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
    hl.bind(mainMod .. " + mouse_up",   hl.dsp.focus({ workspace = "e-1" }))

    hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true })
    hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })

    -- Draw-a-terminal (quickshell/widgets/DrawTerminal.qml): report
    -- <MOD> + left-click to Quickshell as global shortcuts. non_consuming, so
    -- SUPER+drag still moves windows and ALT/CTRL+click still reach apps;
    -- Quickshell only acts when the click lands on empty desktop and the
    -- modifier matches Settings › Windows & Layout › Draw a terminal.
    hl.bind(mainMod .. " + mouse:272", hl.dsp.global("quickshell:drawTerminalSuper"), { non_consuming = true })
    hl.bind("ALT + mouse:272",         hl.dsp.global("quickshell:drawTerminalAlt"),   { non_consuming = true })
    hl.bind("CTRL + mouse:272",        hl.dsp.global("quickshell:drawTerminalCtrl"),  { non_consuming = true })

    -- Run-a-command (quickshell/widgets/CommandBox.qml): a bare "/" is
    -- reported to Quickshell, which turns the island into a command box only
    -- when the focused workspace is empty. non_consuming, so "/" still types
    -- normally in every app.
    hl.bind("slash", hl.dsp.global("quickshell:commandSlash"), { non_consuming = true })

    -- Media / brightness keys
    hl.bind("XF86AudioRaiseVolume",  hl.dsp.exec_cmd("pamixer -i 5"),            { locked = true, repeating = true })
    hl.bind("XF86AudioLowerVolume",  hl.dsp.exec_cmd("pamixer -d 5"),            { locked = true, repeating = true })
    hl.bind("XF86AudioMute",         hl.dsp.exec_cmd("pamixer -t"),              { locked = true })
    -- The trailing ipc call shows the island's brightness OSD (sysfs gives
    -- Quickshell no change events to watch).
    hl.bind("XF86MonBrightnessUp",   hl.dsp.exec_cmd("sh -c 'brightnessctl -q set 5%+; qs ipc call island brightness'"), { locked = true, repeating = true })
    hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("sh -c 'brightnessctl -q set 5%-; qs ipc call island brightness'"), { locked = true, repeating = true })
    hl.bind("XF86AudioPlay",         hl.dsp.exec_cmd("playerctl play-pause"),    { locked = true })
    hl.bind("XF86AudioPause",        hl.dsp.exec_cmd("playerctl play-pause"),    { locked = true })
    hl.bind("XF86AudioNext",         hl.dsp.exec_cmd("playerctl next"),          { locked = true })
    hl.bind("XF86AudioPrev",         hl.dsp.exec_cmd("playerctl previous"),      { locked = true })

    --------------------
    ---- WINDOW RULES --
    --------------------

    hl.window_rule({
        name  = "suppress-maximize-events",
        match = { class = ".*" },
        suppress_event = "maximize",
    })

    hl.window_rule({
        -- Fixes XWayland drag issues
        name  = "fix-xwayland-drags",
        match = {
            class      = "^$",
            title      = "^$",
            xwayland   = true,
            float      = true,
            fullscreen = false,
            pin        = false,
        },
        no_focus = true,
    })

    hl.gesture({
        fingers   = 3,
        direction = "horizontal",
        action    = "workspace",
    })

    ---------------------------
    ---- USER OVERRIDES -------
    ---------------------------

    -- Written by the Quickshell settings panel (SUPER+I). Like colors.lua it
    -- is NOT managed by home-manager, and it is loaded last so whatever is
    -- changed there wins over everything above. pcall keeps the compositor
    -- bootable if the file is missing or broken.
    local okSettings, settingsErr = pcall(dofile, os.getenv("HOME") .. "/.config/hypr/settings.lua")
    if not okSettings and not tostring(settingsErr):find("No such file") then
        print("settings.lua failed: " .. tostring(settingsErr))
    end
  '';
}
